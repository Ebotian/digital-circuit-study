{
  "name": "mux4_3bit",
  "inputs": ["S1", "S0",
             "D00", "D01", "D02", "D10", "D11", "D12",
             "D20", "D21", "D22", "D30", "D31", "D32"],
  "outputs": [
    {"name": "Y0", "expr": "(S1 & ((S0 & D30) | (~S0 & D20))) | (~S1 & ((S0 & D10) | (~S0 & D00)))"},
    {"name": "Y1", "expr": "(S1 & ((S0 & D31) | (~S0 & D21))) | (~S1 & ((S0 & D11) | (~S0 & D01)))"},
    {"name": "Y2", "expr": "(S1 & ((S0 & D32) | (~S0 & D22))) | (~S1 & ((S0 & D12) | (~S0 & D02)))"}
  ]
}
